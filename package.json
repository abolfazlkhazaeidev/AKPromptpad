{
  "name": "akpromptpad",
  "productName": "AKPromptpad",
  "version": "1.0.0",
  "description": "Personal offline prompt management workspace for Windows",
  "main": "./out/main/index.js",
  "author": {
    "name": "Abolfazl Kh",
    "email": "abolfazl25262131kh@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
